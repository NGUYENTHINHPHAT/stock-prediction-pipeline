# Prediction target: direction of the close N trading days ahead
PREDICTION_HORIZON=5

# Universe and history
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
LOOKBACK_DAYS=1825
FEATURE_WINDOW=20

# API
API_HOST=0.0.0.0
API_PORT=8000

# MLflow experiment tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=stock_prediction

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
